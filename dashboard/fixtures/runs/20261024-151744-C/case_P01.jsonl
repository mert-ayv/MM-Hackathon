{"ts": "2026-10-24T15:17:46.350+02:00", "seq": 0, "run_id": "20261024-151744-C", "agent": "C", "case_id": "case:P01", "session_id": "ses_00c8175a1a", "type": "case_opened", "case": {"case_id": "case:P01", "set": "practice", "type": "price_increase", "title": "Volute casing HN 50-200: a price increase", "briefing": "Gießerei Brandlhuber (sup:70110) announces +9.5 % on the volute casing HN 50-200 (part:310010) from 1 November 2026, from EUR 126.53 to EUR 138.55, 'due to energy and wages'. Brandlhuber is our sole source and a strategic supplier: keep it healthy. Need: 7300 pc a year for 1 year.", "trigger_doc": "doc:20260911-70110-P01", "parts": ["part:310010"], "suppliers": ["sup:70110"], "negotiable": ["unit_price", "payment_days", "effective_date"], "fixed_terms": {"volume_per_year": 7300, "contract_months": 12, "lead_time_days": 42, "incoterm": "FCA", "index_clause": null, "tooling_eur": 0}, "term_options": {"payment_days": [10, 14, 30, 45, 60, 90], "effective_date": ["2026-11-01", "2027-01-01", "2027-04-01"]}, "buyer": {"need_per_year": 7300, "horizon_years": 1, "current_unit_price": 126.53, "fallback_unit_price": 149.8, "interest_rate": 0.08, "reference_payment_days": 60, "need_lead_time_days": 42, "category_goal": "stabilise", "sustainable_margin_pct": 6, "relationship_eur_per_point": 2500, "fallback_risk_pct": 5, "index_risk_pct": 2, "late_cost_per_day": 250, "cost_per_defect": 60, "freight_eur_per_unit": {"EXW": 3.1, "FCA": 2.05, "DAP": 0.0}, "index_paths": {}, "must_haves": [], "alternative": {"kind": "none", "ref": null, "terms": {}}}, "round_limit": 10, "refs": ["doc:20260911-70110-P01", "ctr:4600070110", "sc:70110@2026Q3", "cost:310010", "idx:PPI-D351@2025-08", "idx:PPI-D351@2026-08", "idx:PPI-C241@2025-08", "idx:PPI-C241@2026-08"], "facts": {}}, "opening": {"sup:70110": {"offer_id": "offer:70110-0", "supplier_name": "Gießerei Brandlhuber GmbH & Co. KG", "priced": {"terms": {"unit_price": 138.55, "payment_days": 30, "effective_date": "2026-11-01"}, "c": 1033473.17, "breakdown": {"price": 1011415.0, "uncovered_need": 0.0, "fallback_risk": 0.0, "payment_terms": 6742.77, "freight": 14965.0, "late_delivery": 0, "quality": 350.4, "tooling": 0.0, "index_clause": 0.0, "index_risk": 0.0, "relationship": 0.0}}, "standard_terms": {"payment_days": 30, "incoterm": "FCA", "lead_time_days": 42, "ppm_commitment": 800, "chargeback_eur_per_complaint": 0}, "body": "Dear Sir or Madam,\n\nas announced in our letter of 11 September, we adjust our price for the volute casing HN 50-200 (part:310010) by 9.5 % from 1 November 2026: from EUR 126.53 to EUR 138.55 per pc. Our quote is attached.\n\nOwing to sustained increases in energy, raw material and wage costs we have no other choice.\n\nMit freundlichen Grüßen\nGießerei Brandlhuber GmbH & Co. KG"}}, "c_alt": null}
