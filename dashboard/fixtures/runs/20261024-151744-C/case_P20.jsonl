ality": 1209.6, "tooling": 12000, "index_clause": 0.0, "index_risk": 0.0, "relationship": 0.0}}, "standard_terms": {"payment_days": 60, "incoterm": "FCA", "lead_time_days": 70, "ppm_commitment": 2400, "chargeback_eur_per_complaint": 0, "tooling_eur": 12000, "contract_months": 12}, "body": "Dear Madam,\n\nwe are pleased to quote EUR 168.90 per pc FCA Kalwisz, 60 days net, tooling EUR 12,000. Lead time 70 days from order.\n\nBest regards\nOdlewnia Kalwisz Sp. z o.o."}}, "c_alt": null}
