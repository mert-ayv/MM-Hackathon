{"ts": "2026-10-24T14:30:08.054+02:00", "seq": 0, "run_id": "20261024-143005-A", "agent": "A", "case_id": "case:P20", "session_id": "ses_006563b6dc", "type": "case_opened", "case": {"case_id": "case:P20", "set": "practice", "type": "rfq", "title": "Volute casing HX 80-200: RFQ for a new part", "briefing": "The new HX series starts production in March 2027. We ask three foundries to quote the volute casing HX 80-200 (part:310070, EN-GJS-500-7, 44 kg): Eisengießerei Velkenreith (sup:70120), Gießerei Wimbacher (sup:70130) and Odlewnia Kalwisz (sup:70140). Quality first: a casing that leaks costs us a pump. Need: 4200 pc a year for 2 years (rfq:6000000306).", "trigger_doc": null, "parts": ["part:310070"], "suppliers": ["sup:70120", "sup:70130", "sup:70140"], "negotiable": ["unit_price", "payment_days", "contract_months", "incoterm"], "fixed_terms": {"volume_per_year": 4200, "index_clause": null}, "term_options": {"payment_days": [30, 45, 60, 90], "contract_months": [12, 24], "incoterm": ["EXW", "FCA", "DAP"]}, "buyer": {"need_per_year": 4200, "horizon_years": 2, "current_unit_price": null, "fallback_unit_price": 205.0, "interest_rate": 0.08, "reference_payment_days": 60, "need_lead_time_days": 56, "category_goal": "quality_first", "fallback_risk_pct": 6, "index_risk_pct": 2, "late_cost_per_day": 300, "cost_per_defect": 120, "freight_eur_per_unit": {"EXW": 5.6, "FCA": 3.9, "DAP": 0.0}, "index_paths": {}, "must_haves": [{"field": "ppm_commitment", "op": "<=", "value": 2500}], "alternative": {"kind": "none", "ref": null, "terms": {}}}, "round_limit": 10, "refs": ["rfq:6000000306", "sc:70120@2026Q3", "sc:70130@2026Q3", "sc:70140@2026Q3", "news:20260322-05", "news:20260911-28", "idx:PPI-C2451@2025-08", "idx:PPI-C2451@2026-08"], "facts": {}}, "opening": {"sup:70120": {"offer_id": "offer:70120-0", "supplier_name": "Eisengießerei Velkenreith GmbH", "priced": {"terms": {"unit_price": 184.5, "payment_days": 45, "contract_months": 12, "incoterm": "FCA"}, "c": 1722875.8, "breakdown": {"price": 774900.0, "uncovered_need": 861000.0, "fallback_risk": 51660.0, "payment_terms": 2583.0, "freight": 16380.0, "late_delivery": 0, "quality": 352.8, "tooling": 16000, "index_clause": 0.0, "index_risk": 0.0, "relationship": 0.0}}, "standard_terms": {"payment_days": 45, "incoterm": "FCA", "lead_time_days": 49, "ppm_commitment": 700, "chargeback_eur_per_complaint": 0, "tooling_eur": 16000, "contract_months": 12}, "body": "Dear Ms Huber,\n\nthank you for your enquiry. For the volute casing HX 80-200 in EN-GJS-500-7 we quote EUR 184.50 per pc FCA Velkenreith, 45 days net, tooling EUR 16,000, lead time 49 days. Our quote is attached.\n\nMit freundlichen Grüßen\nEisengießerei Velkenreith GmbH"}, "sup:70130": {"offer_id": "offer:70130-0", "supplier_name": "Gießerei Wimbacher GmbH", "priced": {"terms": {"unit_price": 179.8, "payment_days": 30, "contract_months": 12, "incoterm": "FCA"}, "c": 1708112.4, "breakdown": {"price": 755160.0, "uncovered_need": 861000.0, "fallback_risk": 51660.0, "payment_terms": 5034.4, "freight": 16380.0, "late_delivery": 0, "quality": 378.0, "tooling": 18500, "index_clause": 0.0, "index_risk": 0.0, "relationship": 0.0}}, "standard_terms": {"payment_days": 30, "incoterm": "FCA", "lead_time_days": 45, "ppm_commitment": 750, "chargeback_eur_per_complaint": 0, "tooling_eur": 18500, "contract_months": 12}, "body": "Dear Ms Huber,\n\nmany thanks for thinking of us for the new HX series. We quote EUR 179.80 per pc FCA, 30 days net, tooling EUR 18,500, 45 days lead time.\n\nWe would be glad to become a long-term partner for the HX series.\n\nHerzliche Grüße\nGießerei Wimbacher GmbH"}, "sup:70140": {"offer_id": "offer:70140-0", "supplier_name": "Odlewnia Kalwisz Sp. z o.o.", "priced": {"terms": {"unit_price": 168.9, "payment_days": 60, "contract_months": 12, "incoterm": "FCA"}, "c": 1655829.6, "breakdown": {"price": 709380.0, "uncovered_need": 861000.0, "fallback_risk": 51660.0, "payment_terms": 0.0, "freight": 16380.0, "late_delivery": 4200, "quality": 1209.6, "tooling": 12000, "index_clause": 0.0, "index_risk": 0.0, "relationship": 0.0}}, "standard_terms": {"payment_days": 60, "incoterm": "FCA", "lead_time_days": 70, "ppm_commitment": 2400, "chargeback_eur_per_complaint": 0, "tooling_eur": 12000, "contract_months": 12}, "body": "Dear Madam,\n\nwe are pleased to quote EUR 168.90 per pc FCA Kalwisz, 60 days net, tooling EUR 12,000. Lead time 70 days from order.\n\nBest regards\nOdlewnia Kalwisz Sp. z o.o."}}, "c_alt": null}
