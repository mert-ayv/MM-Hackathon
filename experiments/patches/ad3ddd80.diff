+    def leader_cost(self, case, threads, exclude=None):
+        """The lowest C any other live supplier offers right now (inf if none)."""
+        best = math.inf
+        for s in live_threads(threads):
+            if s == exclude:
+                continue
+            std = standard_terms(threads[s])
