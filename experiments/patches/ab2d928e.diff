@@ -0,0 +1,208 @@
+"""Experiment (Sat night): an LLM that moves with our deterministic functions as tools. NOT routed.
+
+Per move the router first computes its default move. The model then sees the supplier's last e-mail, a short
+history and that default, and may change the packages by calling our functions:
+
+- price_package(terms): our exact total cost of a package vs the default, its current offer and our alternative
+- submit_move(sheets, reason): the move it wants to send (1-3 packages)
+
+Code checks every submitted move: valid terms, must-haves kept, cheaper for us than our alternative, not dearer
+for us than its current offer, and at most 3 % of C deeper than the default ask. Anything else - a timeout
+(TOOL_BUDGET_S), an API error, an invalid move, no submit - sends the default move unchanged. Accept and
+walk-away stay deterministic (close() is the router's).
+"""
+
+import json
+import logging
+import os
+import time
+
+from arena_kit.cost import complete_offer, total_cost
+from arena_kit.docs import standard_terms
+from arena_kit.play import latest, standing
+
+from .. import levers
+from ..agent import must_haves_ok
+from ..writer import TemplateWriter
+from .router import RouterAgent
+
+log = logging.getLogger("csee")
+
+TOOL_BUDGET_S = 22.0  # the model's whole turn; the writer then has its own 15 s, the supplier waits 60 s
+MAX_TURNS = 4
+DEEPEST = 0.03  # a submitted ask may be at most this share of C cheaper for us than the default ask
+
+SYSTEM = """You are the negotiation strategist of Hollerau Pumpenwerke's purchasing team, negotiating by e-mail
+with an industrial supplier. Deterministic code has proposed a DEFAULT MOVE (term sheets). It was tuned on
+these suppliers: they mirror our concession up to a cap, go final when our ask stays far from theirs, and agree
+to any sheet worth at least their current ask. Keep the default unless the supplier's e-mail gives you a concrete
+reason to change it - e.g. it names a lever (faster payment, a clause, volume, lead time, contract length) we
+can give cheaply, it asks a question a different package answers, or it signals it is at its limit.
+Use price_package to check what any change costs us before you submit. Then call submit_move exactly once.
+Every package must contain every negotiable field. Prices are EUR per unit."""
+
+TOOLS = [
+    {
+        "name": "price_package",
+        "description": "Our exact total cost C of one package (lower is better for us), compared with the default "
+        "main sheet, the supplier's current offer and our alternative. Also says if it keeps our must-haves.",
+        "input_schema": {
+            "type": "object",
+            "properties": {"terms": {"type": "object", "description": "negotiable field -> value"}},
+            "required": ["terms"],
+        },
+    },
+    {
+        "name": "submit_move",
+        "description": "Send this move: 1-3 packages, the first is our main ask. Use the default packages "
+        "unchanged if you see no concrete reason to change them.",
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "sheets": {"type": "array", "items": {"type": "object"}, "minItems": 1, "maxItems": 3},
+                "reason": {"type": "string", "description": "one sentence: why this move"},
+            },
+            "required": ["sheets", "reason"],
+        },
+    },
+]
+
+
+def _client():
+    import anthropic
+
+    return anthropic.Anthropic(timeout=TOOL_BUDGET_S)
+
+
+class ToolAgent(RouterAgent):
+    """The final router's agents decide the default; the model may change the packages within code checks."""
+
+    def __init__(self, package=None, writer=None, params=None):
+        super().__init__(package, writer, params)
+        self.model = os.environ.get("TOOL_MODEL") or os.environ.get("LLM_MODEL") or "claude-opus-5-5"
+        self.tool_log = []  # (case, sid, used_default, reason)
+
+    def thread_move(self, case, threads, sid):
+        msg = super().thread_move(case, threads, sid)
+        if not msg or not msg.get("term_sheets") or os.environ.get("LLM_PROVIDER") != "anthropic":
+            return msg
+        try:
+            chosen, reason = self._consult(case, threads, sid, msg)
+        except Exception as e:  # the default move always stands
+            log.warning("toolagent %s: model failed (%r): default move", sid, e)
+            chosen, reason = None, f"error {e!r}"
+        self.tool_log.append((case["case_id"], sid, chosen is None, reason))
+        if chosen is None:
+            return msg
+        return self._rebuild(case, threads, sid, msg, chosen, reason)
+
+    # ---------- the model's turn ----------
+    def _context(self, case, threads, sid, msg):
+        inner = self.inner
+        ev = threads[sid]
+        std = standard_terms(ev)
+        theirs = standing(ev)[1]
+        default = [s["terms"] for s in msg["term_sheets"]]
+        c_default = total_cost(case, complete_offer(case, default[0]), std)
+        c_theirs = total_cost(case, theirs, std) if theirs.get("unit_price") else None
+        c_alt = levers.alternative_cost(case)
+        hist = []
+        for m in ev[-6:]:
+            who = "WE" if m.get("from") == "buyer" else f"SUPPLIER ({m.get('status')})"
+            sheets = [x.get("terms", x) for x in m.get("term_sheets") or []]
+            hist.append(f"{who}: sheets {json.dumps(sheets)[:600]}")
+        profile = inner.threads[sid].intel.profile if inner and sid in inner.threads else {}
+        text = "\n".join(
+            [
+                f"CASE: {case.get('title')} (type {case.get('type')}, goal {case['buyer'].get('category_goal')})",
+                f"NEGOTIABLE: {case['negotiable']}; OPTIONS: {json.dumps(case.get('term_options'))[:1200]}",
+                f"MUST-HAVES: {json.dumps(case['buyer'].get('must_haves', []))}",
+                f"SUPPLIER PROFILE: {json.dumps({k: profile.get(k) for k in ('name', 'what_it_values', 'likely_tradeables', 'pressures')}, ensure_ascii=False)[:1500]}",
+                "RECENT ROUNDS:\n" + "\n".join(hist),
+                f"ITS LAST E-MAIL:\n{(latest(ev).get('body') or '')[:2000]}",
+                f"DEFAULT MOVE (our rules): {json.dumps(default)}",
+                f"Our cost of the default main sheet: {c_default:,.0f}; of its current offer: "
+                f"{'-' if c_theirs is None else f'{c_theirs:,.0f}'}; of our alternative: {c_alt:,.0f}",
+            ]
+        )
+        return text, std, default, c_default, c_theirs, c_alt
+
+    def _price(self, case, std, terms, c_default, c_theirs, c_alt):
+        t = complete_offer(case, terms)
+        c = total_cost(case, t, std)
+        return {
+            "package": t,
+            "our_cost": round(c),
+            "vs_default_pct": round((c / c_default - 1) * 100, 2),
+            "vs_their_offer_pct": None if c_theirs is None else round((c / c_theirs - 1) * 100, 2),
+            "beats_alternative": c < c_alt,
+            "must_haves_ok": must_haves_ok(case, t, std),
+        }
+
+    def _valid(self, case, std, sheets, c_default, c_theirs, c_alt):
+        out = []
+        for s in sheets[:3]:
+            if not isinstance(s, dict) or s.get("unit_price") is None and "unit_price" in case["negotiable"]:
+                return None
+            t = complete_offer(case, s)
+            c = total_cost(case, t, std)
+            if not must_haves_ok(case, t, std) or c >= c_alt:
+                return None
+            if c_theirs is not None and c > c_theirs:
+                return None  # dearer for us than what it already offers
+            if c < c_default * (1 - DEEPEST):
+                return None  # far deeper than our rules ask: risks its early final or a walk
+            out.append(t)
+        return out or None
+
+    def _consult(self, case, threads, sid, msg):
+        text, std, default, c_default, c_theirs, c_alt = self._context(case, threads, sid, msg)
+        client, t0 = _client(), time.monotonic()
+        messages = [{"role": "user", "content": text}]
+        for _ in range(MAX_TURNS):
+            left = TOOL_BUDGET_S - (time.monotonic() - t0)
+            if left < 4:
+                return None, "budget"
+            r = client.with_options(timeout=left).messages.create(
+                model=self.model,
+                max_tokens=2000,
+                system=SYSTEM,
+                tools=TOOLS,
+                messages=messages,
+                output_config={"effort": "low"},
+            )
+            messages.append({"role": "assistant", "content": r.content})
+            calls = [b for b in r.content if b.type == "tool_use"]
+            if not calls:
+                return None, "no submit"
+            results = []
+            for b in calls:
+                if b.name == "submit_move":
+                    sheets = self._valid(case, std, b.input.get("sheets") or [], c_default, c_theirs, c_alt)
+                    reason = str(b.input.get("reason") or "")[:300]
+                    if sheets is None:
+                        return None, f"invalid move: {reason}"
+                    if sheets == [complete_offer(case, s) for s in default][: len(sheets)]:
+                        return None, f"kept default: {reason}"
+                    return sheets, reason
+                out = self._price(case, std, b.input.get("terms") or {}, c_default, c_theirs, c_alt)
+                results.append({"type": "tool_result", "tool_use_id": b.id, "content": json.dumps(out)})
+            messages.append({"role": "user", "content": results})
+        return None, "turns"
+
+    # ---------- the changed move ----------
+    def _rebuild(self, case, threads, sid, msg, sheets, reason):
+        inner = self.inner
+        st = inner.threads[sid]
+        if st.our_prices and sheets[0].get("unit_price") is not None:
+            st.our_prices[-1] = sheets[0]["unit_price"]
+        ids = set(msg.get("refs") or [])
+        claims = [c for c in st.intel.claims if set(c.ids) & ids]
+        ev = list(threads[sid])
+        body = TemplateWriter().write(case, inner, sid, ev, sheets, claims, False)
+        out = {**msg, "body": body, "term_sheets": [{"terms": s} for s in sheets]}
+        out.pop("_write", None)
+        if inner.writer is not None and not isinstance(inner.writer, TemplateWriter):
+            out["_write"] = lambda: inner.writer.write(case, inner, sid, ev, sheets, claims, False)
+        log.info("toolagent %s %s: changed the move (%s)", case["case_id"], sid, reason)
+        return out
