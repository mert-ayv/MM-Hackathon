index 0000000..2404f18
--- /dev/null
+++ b/starter-kit/csee/agents/raw_feedback.py
@@ -0,0 +1,74 @@
+"""Conservative, quote-backed feedback rules. No supplier IDs or target prices.
+
+Unknown wording yields no rule. A quoted duration limits the rule to that exact
+duration; only explicit multi-year wording applies to all terms over 12 months.
+Supplier sheets can supersede an earlier refusal. This is a small deterministic
+interpreter, not a general language-understanding model.
+"""
+
+import re
+
+
+def sentences(body):
+    return re.split(r"(?<=[.!?])\s+|\n+", body or "")
+
+
+def index_requirement(months, events):
+    """Evidence against a fixed-price package of this duration, or None."""
+    if not isinstance(months, (int, float)):
+        return None
+    for event in reversed(events):
+        if event.get("from") == "buyer":
+            continue
+        # An actual later fixed quote overrides earlier prose, only on its duration.
+        if any(s.get("terms", {}).get("contract_months") == months
+               and "index_clause" in s.get("terms", {})
+               and s["terms"]["index_clause"] is None
+               for s in event.get("term_sheets", [])):
+            return None
+        for sentence in sentences(event.get("body")):
+            text = sentence.lower()
+            refuses_fixed = re.search(
+                r"\b(?:cannot|can't|can not|unable to) (?:offer|provide|accept|agree to) (?:a )?fixed[- ]prices?", text
+            )
+            requires_index = (
+                re.search(r"\b(?:must|require|requires|insist on|provided (?:we|you) include)\b", text)
+                and re.search(
+                    r"\b(?:index clause|price adjustment clause|alloy surcharge clause|preisgleitklausel)\b", text
+                )
+            )
+            if not (refuses_fixed or requires_index):
+                continue
+            if re.search(r"\b(?:not|never) (?:require|insist)|\b(?:do not|don't) (?:need|require)|\bmust not\b", text):
+                continue
+            durations = {int(n) for n in re.findall(r"\b(\d+)\s*[- ]months?\b", text)}
+            multi_year = bool(re.search(r"\bmulti[- ]year\b", text))
+            if months in durations or (multi_year and months > 12):
+                return {"quote": sentence.strip(), "duration_months": sorted(durations),
+                        "multi_year": multi_year,
+                        "series": re.findall(r"\b[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+\b", sentence)}
+    return None
+
+
+def dismissed_order_history(events):
+    """Latest explicit response to a cited order-history argument; silence is not rejection."""
+    verdict = None
+    cited_orders = False
+    for event in events:
+        if event.get("from") == "buyer":
+            cited_orders = any(str(ref).startswith("po:") for ref in event.get("refs", []))
+            cited_orders |= bool(re.search(r"\bpo:[\w:-]+", event.get("body") or ""))
+            continue
+        if not cited_orders:
+            continue
+        for sentence in sentences(event.get("body")):
+            text = sentence.lower()
+            if not re.search(
+                r"\b(?:price history|historical (?:purchase orders|prices)|past prices|purchase orders)\b", text
+            ):
+                continue
+            if re.search(r"(?:does|do) not (?:change|alter|affect|impact) .{0,35}(?:calculation|cost|pricing)", text):
+                verdict = {"quote": sentence.strip(), "kind": "order_history"}
+            elif re.search(r"(?:took|taken) (?:it|them|this|these) into account|adjusted .{0,25}calculation", text):
+                verdict = None
+    return verdict
