--- /dev/null
+++ b/starter-kit/csee/negotiation/policy.py
@@ -0,0 +1,121 @@
+"""Final authority for a complete binding proposal. No post-validation term rewriting."""
+
+from arena_kit.cost import closing_terms, must_haves_ok
+
+from .. import levers
+from . import constraints, control, economics
+
+
+def binding_error(case, terms, std, supplier, ceiling):
+    if not must_haves_ok(case, terms, std):
+        return "buyer must-have violated"
+    if economics.decision_cost(case, terms, std, supplier) > ceiling + 0.01:
+        return "complete package exceeds decision-cost ceiling"
+    if economics.decision_cost(case, terms, std, supplier) >= levers.alternative_cost(case):
+        return "outside alternative is better under the decision objective"
+    if (
+        "unit_price" in case["negotiable"]
+        and terms["unit_price"] < economics.optimal_price(case, terms, std, supplier) - 0.01
+    ):
+        return "price below stable relationship-cost optimum"
+    return None
+
+
+def previously_tested(case, terms, events, std):
+    target = closing_terms(case, terms, std)
+    for event in events:
+        sheets = event.get("term_sheets", [])
+        if event.get("from") != "buyer" or len(sheets) < 2:
+            continue
+        main = closing_terms(case, sheets[0]["terms"], std)
+        for sheet in sheets[1:]:
+            alternative = closing_terms(case, sheet["terms"], std)
+            changed = [f for f in case["negotiable"] if f != "unit_price" and alternative.get(f) != main.get(f)]
+            if changed and all(target.get(f) == alternative.get(f) for f in changed):
+                return True
+    return False
+
+
+def finalize(
+    case,
+    events,
+    candidates,
+    selected,
+    alternative_ids,
+    state,
+    records,
+    std,
+    supplier,
+    ceiling,
+    constraint_override=False,
+    fallback=False,
+):
+    adjustments, rejected = [], []
+    valid = []
+    for row in candidates:
+        reason = binding_error(case, row["terms"], std, supplier, ceiling)
+        if not reason and constraints.violations(case, row["terms"], std, records):
+            reason = "contradicts a grounded supplier constraint"
+        if reason:
+            rejected.append({"candidate_id": row["id"], "reason": reason})
+        else:
+            valid.append(row)
+    if not valid:
+        return [], adjustments, rejected
+    established = state.get("established_package")
+    stable = next(
+        (r for r in valid if established and control.same_package(closing_terms(case, r["terms"], std), established)),
+        None,
+    )
+    if selected not in valid:
+        selected = stable or min(valid, key=lambda r: r["cost"])
+        adjustments.append("invalid selection replaced with an already validated complete package")
+    concession = selected.get("term_concession", {})
+    if concession.get("compensation") == "unconfirmed":
+        protected = [
+            r
+            for r in valid
+            if all(r["terms"].get(f) == concession["reference_terms"].get(f) for f in concession["fields"])
+        ]
+        if protected:
+            reference = min(protected, key=lambda r: r["cost"])
+            if not economics.materially_better(
+                case, selected["terms"], reference["terms"], std, supplier, fraction=0.001
+            ):
+                selected = reference
+                adjustments.append(
+                    "retained protected package: surrendered terms lack material full-package compensation"
+                )
+    if (
+        stable
+        and not constraint_override
+        and not control.same_package(closing_terms(case, selected["terms"], std), established)
+        and not economics.materially_better(case, selected["terms"], stable["terms"], std, supplier)
+    ):
+        selected = stable
+        adjustments.append("established primary retained: no material improvement supports a switch")
+    bundle = [selected]
+    # No speculative alternatives during a model failure. The default primary is sufficient.
+    ordered = [] if fallback else [r for id_ in alternative_ids for r in valid if r["id"] == id_]
+    for row in ordered:
+        if row in bundle or control.same_package(
+            closing_terms(case, row["terms"], std), closing_terms(case, selected["terms"], std)
+        ):
+            continue
+        reason = None
+        if previously_tested(case, row["terms"], events, std):
+            reason = "alternative lever already tested; do not repeat it as a learning probe"
+        elif not economics.materially_better(case, row["terms"], selected["terms"], std, supplier, fraction=0.001):
+            reason = "alternative lacks a material complete-cost improvement across assumptions"
+        elif any(
+            control.same_package(closing_terms(case, row["terms"], std), closing_terms(case, r["terms"], std))
+            for r in bundle
+        ):
+            reason = "duplicate structure"
+        if reason:
+            rejected.append({"candidate_id": row["id"], "reason": reason})
+        else:
+            bundle.append(row)
+        if len(bundle) == 3:
+            break
+    return bundle, adjustments, rejected
