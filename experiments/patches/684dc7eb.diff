@@ -0,0 +1,131 @@
+"""Isolated raw-material ablation of the current router's package construction.
+
+Only restore the existing planner's target after parent builders replace sheet
+zero. No new anchor, contract preference, index valuation or closing rule. This
+often raises our price; a correct plan is not evidence of a better live score.
+"""
+
+import math
+
+from arena_kit.cost import closing_terms, must_haves_ok, total_cost
+
+from .. import levers
+from . import raw_feedback
+from .mert_dossier import PlanMesoRawDossierClaims
+
+
+class EgeRawPlanAgent(PlanMesoRawDossierClaims):
+    def prepare(self, case, threads):
+        self.restore_main_plan = case.get("type") == "raw_material"
+        super().prepare(case, threads)
+
+    def sheets(self, case, sid, ours, std, supplier):
+        out = super().sheets(case, sid, ours, std, supplier)
+        if self.restore_main_plan and self.log.enabled:
+            model = self.sup_model(case, sid, std)
+            self.log.event(
+                "raw_plan_audit",
+                supplier_id=sid,
+                planned_supplier_value=getattr(self.threads[sid], "plan_v", None),
+                draft_supplier_value=self.sval(case, model, ours),
+                outgoing_supplier_values=[self.sval(case, model, terms) for terms in out],
+                draft_terms=ours,
+                outgoing_terms=out,
+            )
+        return out
+
+
+class EgeRawMemoryAgent(PlanMesoRawDossierClaims):
+    """Reply-driven package/evidence memory on the unchanged current raw route.
+
+    Primary prices and stopping rules remain the parent's. An explicitly rejected
+    fixed-price alternative is repriced with the mutually quoted main clause, or
+    omitted if it cannot meet the original cost/value budgets and prior offers.
+    """
+
+    structure_memory = True
+    evidence_memory = True
+
+    def sheets(self, case, sid, ours, std, supplier):
+        out = super().sheets(case, sid, ours, std, supplier)
+        if not self.raw or not self.structure_memory or not out:
+            return out
+        events = self.threads[sid].events
+        main = out[0]
+        clause = main.get("index_clause")
+        model = self.sup_model(case, sid, std)
+        main_value = self.sval(case, model, main)
+        quoted_clauses = [s.get("terms", {}).get("index_clause") for e in reversed(events)
+                          if e.get("from") != "buyer" for s in e.get("term_sheets", [])]
+        result = [main]
+        changes = []
+        for sheet in out[1:]:
+            rule = (raw_feedback.index_requirement(closing_terms(case, sheet, std)["contract_months"], events)
+                    if not sheet.get("index_clause") else None)
+            if not rule:
+                result.append(sheet)
+                continue
+            replacement = None
+            if (clause and clause in quoted_clauses and clause in levers.options(case, "index_clause")
+                    and (not rule["series"] or clause.get("series") in rule["series"])
+                    and "index_clause" in case["negotiable"] and "unit_price" in case["negotiable"]
+                    and main_value is not None):
+                replacement = self.indexed_alternative(case, sid, sheet, main, clause, std, supplier, model, main_value)
+                if replacement and any(self.same_terms(replacement, s) for s in result):
+                    replacement = None
+            if replacement:
+                result.append(replacement)
+            changes.append({"evidence": rule, "before": sheet, "after": replacement})
+        if changes and self.log.enabled:
+            self.log.event("raw_feedback", supplier_id=sid, package_changes=changes)
+        return result
+
+    def indexed_alternative(self, case, sid, sheet, main, clause, std, supplier, model, main_value):
+        candidate = {**sheet, "index_clause": clause}
+        target = min(total_cost(case, sheet, std, supplier), total_cost(case, main, std, supplier))
+        price = levers.price_for(case, candidate, target, std, supplier)
+        ceiling = self.price_at_value(case, model, candidate, main_value)
+        if price is None or ceiling is None:
+            return None
+        candidate["unit_price"] = math.floor(min(price, ceiling) * 100 + 1e-7) / 100
+        if total_cost(case, candidate, std, supplier) > target + .001:
+            candidate["unit_price"] = round(candidate["unit_price"] - .01, 2)
+        # Do not retract any previous binding offer on this exact structure.
+        previous = [s.get("terms", {}) for e in self.threads[sid].events if e.get("from") == "buyer"
+                    for s in e.get("term_sheets", [])]
+        prior_prices = [s["unit_price"] for s in previous if s.get("unit_price") is not None
+                        and self.same_terms(closing_terms(case, s, std), closing_terms(case, candidate, std))]
+        candidate["unit_price"] = max([candidate["unit_price"], *prior_prices])
+        value = self.sval(case, model, candidate)
+        if (candidate["unit_price"] <= 0 or not must_haves_ok(case, candidate, std)
+                or total_cost(case, candidate, std, supplier) > target + .001
+                or value is None or value > main_value + 1e-7):
+            return None
+        return candidate
+
+    def pick_claims(self, case, threads, sid):
+        if not self.raw or not self.evidence_memory:
+            return super().pick_claims(case, threads, sid)
+        rejected = raw_feedback.dismissed_order_history(threads[sid])
+        if not rejected:
+            return super().pick_claims(case, threads, sid)
+        info = self.threads[sid].intel
+        original = info.claims
+        # Filter before the parent consumes citation IDs; skipped claims aren't sent.
+        info.claims = [c for c in original if not (c.tag == "po" or any(i.startswith("po:") for i in c.ids))]
+        try:
+            chosen = super().pick_claims(case, threads, sid)
+        finally:
+            info.claims = original
+        if self.log.enabled:
+            self.log.event("raw_feedback", supplier_id=sid, dismissed_argument=rejected,
+                           selected_claim_kinds=[c.kind for c in chosen])
+        return chosen
+
+
+class EgeRawStructureAgent(EgeRawMemoryAgent):
+    evidence_memory = False
+
+
+class EgeRawEvidenceAgent(EgeRawMemoryAgent):
+    structure_memory = False
